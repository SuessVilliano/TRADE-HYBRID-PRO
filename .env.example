# TRADE-HYBRID-PRO environment variables
# Copy to .env for local dev. Set real values ONLY in the host's env settings
# (Vercel project "trade-hybrid" -> Settings -> Environment Variables, or Replit Secrets).
# Never commit real values. Never put secrets in VITE_* variables: Vite inlines them
# into the public browser bundle.

# --- Core ---
NODE_ENV=
PORT=
DATABASE_URL=
SESSION_SECRET=
ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY=
APP_URL=
FRONTEND_URL=
API_PUBLIC_URL=

# --- Alpaca (server-side only) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_API_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_BROKER_API_KEY=
ALPACA_BROKER_API_SECRET=
ALPACA_BROKER_API_URL=

# --- IronBeam (server-side only; reserved for a future server proxy) ---
# The browser client no longer embeds IronBeam credentials. Nothing reads these yet.
IRONBEAM_USERNAME=
IRONBEAM_PASSWORD=
IRONBEAM_API_KEY=

# --- Market data ---
RAPID_API_KEY=
GOOGLE_API_KEY=
BIRDEYE_API_KEY=
SOLSCAN_API_KEY=
TRADINGVIEW_API_KEY=
TRADINGVIEW_SESSION_TOKEN=
TRADINGVIEW_WEBHOOK_SECRET=
CME_API_KEY=
CME_CLIENT_ID=
CME_CLIENT_SECRET=

# --- AI ---
OPENAI_API_KEY=
GEMINI_API_KEY=
VAPI_API_KEY=

# --- Whop (payments / club) ---
WHOP_API_KEY=
WHOP_APP_ID=
WHOP_CLIENT_ID=
WHOP_CLIENT_SECRET=
WHOP_WEBHOOK_SECRET=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# --- Other brokers (server-side only) ---
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_API_URL=
BINANCE_API_KEY=
BINANCE_API_SECRET=
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ACCOUNT_ID=
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
NINJATRADER_API_KEY=
NINJATRADER_TOKEN=
MATCHTRADER_USERNAME=
MATCHTRADER_PASSWORD=
MATCHTRADER_API_KEY=

# --- Push / SSO ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
TH_SSO_SECRET=
TH_SSO_ALLOWED_ORIGINS=

# --- Client (PUBLIC: baked into the browser bundle; no secrets here) ---
VITE_API_BASE_URL=
VITE_SITE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_VAPID_PUBLIC_KEY=
VITE_USE_MOCK_SERVICE=
# Do NOT set VITE_ALPACA_API_SECRET, VITE_OPENAI_API_KEY or VITE_WHOP_API_KEY.
# The client still references them, but any value set would be public. They need a server-side follow-up.
